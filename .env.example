# Application
NODE_ENV=development
PORT=3000
APP_NAME=WorkforceSaaS
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=workforce_saas
DB_USER=root
DB_PASS=your_db_password_here

# Session
SESSION_SECRET=replace_with_a_long_random_string_at_least_64_chars
SESSION_MAX_AGE_MS=28800000

# Encryption (AES-256-GCM — must be exactly 32 bytes / 64 hex chars)
ENCRYPTION_KEY=replace_with_64_char_hex_string_here_do_not_commit_real_value

# Email / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM="WorkforceSaaS <noreply@example.com>"

# Super Admin (seed only — change after first login)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
