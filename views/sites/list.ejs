<%- include('../partials/breadcrumb', { items: [{ label: t('sites_title') }] }) %>

<!-- Page header -->
<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
  <div>
    <h4 class="mb-0 fw-bold"><i class="bi bi-geo-alt me-2" style="color:var(--em-accent)"></i><%= t('sites_title') %></h4>
    <div style="font-size:.78rem;color:var(--em-ink-3);margin-top:3px">Work sites and project locations</div>
  </div>
  <a href="/sites/new" class="btn btn-primary btn-sm">
    <i class="bi bi-plus-lg me-1"></i><%= t('sites_new_btn') %>
  </a>
</div>

<!-- Filter bar -->
<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
  <form class="d-flex align-items-center gap-2" method="GET">
    <select name="status" class="form-select form-select-sm" style="max-width:150px" onchange="this.form.submit()">
      <option value=""><%= t('common_all_statuses') %></option>
      <option value="active"   <%= query.status === 'active'   ? 'selected' : '' %>><%= t('common_active') %></option>
      <option value="inactive" <%= query.status === 'inactive' ? 'selected' : '' %>><%= t('common_inactive') %></option>
    </select>
    <% if (query.status) { %>
      <a href="/sites" class="btn btn-outline-secondary btn-sm">Clear</a>
    <% } %>
  </form>
  <span style="font-size:.78rem;color:var(--em-ink-3)"><%= pageData.total %> site<%= pageData.total !== 1 ? 's' : '' %></span>
</div>

<% if (sites.length === 0) { %>
<div class="card" style="border-radius:12px">
  <div class="card-body text-center py-5" style="color:var(--em-ink-3)">
    <i class="bi bi-geo-alt" style="font-size:2rem;display:block;margin-bottom:.5rem;opacity:.4"></i>
    <%= t('sites_no_results') %>
    <div class="mt-3"><a href="/sites/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i><%= t('sites_new_btn') %></a></div>
  </div>
</div>

<% } else { %>

<!-- Mobile: site cards -->
<div class="d-md-none">
  <% sites.forEach(site => {
    const workerCount = wMap[site.id] || 0;
    const isActive = site.status === 'active';
  %>
  <div class="card mb-2" style="border-radius:12px;border-left:3px solid <%= isActive ? 'var(--eos-green-600)' : 'var(--em-line)' %>">
    <div class="card-body" style="padding:.85rem 1rem">
      <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
        <div>
          <a href="/sites/<%= site.id %>/edit" class="fw-semibold text-decoration-none" style="color:var(--em-ink);font-size:.9rem"><%= site.name %></a>
          <% if (site.location) { %>
          <div style="font-size:.72rem;color:var(--em-ink-3);margin-top:1px">
            <i class="bi bi-geo me-1"></i><%= site.location %>
          </div>
          <% } %>
        </div>
        <span class="badge" style="background:<%= isActive ? 'var(--eos-green-50)' : 'var(--em-surface-2)' %>;color:<%= isActive ? 'var(--eos-green-600)' : 'var(--em-ink-3)' %>;border:0.5px solid <%= isActive ? '#a8d57a' : 'var(--em-line)' %>;font-size:.7rem;flex-shrink:0">
          <%= site.status %>
        </span>
      </div>
      <div class="d-flex align-items-center gap-3" style="font-size:.78rem;color:var(--em-ink-2)">
        <span>
          <i class="bi bi-people me-1" style="color:var(--em-accent)"></i>
          <strong><%= workerCount %></strong> worker<%= workerCount !== 1 ? 's' : '' %>
        </span>
        <% if (site.supervisor) { %>
        <span>
          <i class="bi bi-person-gear me-1" style="color:var(--em-accent)"></i>
          <%= site.supervisor.name %>
        </span>
        <% } else { %>
        <span style="color:var(--em-ink-3)"><i class="bi bi-person-dash me-1"></i><%= t('common_unassigned') %></span>
        <% } %>
      </div>
    </div>
  </div>
  <% }) %>
</div>

<!-- Desktop: table -->
<div class="d-none d-md-block">
  <div class="card" style="border-radius:12px">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th style="padding:10px 16px"><%= t('sites_col_name') %></th>
              <th><%= t('sites_col_location') %></th>
              <th><%= t('sites_col_supervisor') %></th>
              <th class="text-center"><%= t('sites_col_workers') %></th>
              <th><%= t('common_status') %></th>
              <th style="width:70px"><%= t('common_actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% sites.forEach(site => {
              const workerCount = wMap[site.id] || 0;
              const isActive = site.status === 'active';
            %>
            <tr>
              <td style="padding:9px 16px">
                <a href="/sites/<%= site.id %>/edit" class="fw-semibold text-decoration-none" style="color:var(--em-ink)"><%= site.name %></a>
              </td>
              <td class="small text-muted"><%= site.location || '—' %></td>
              <td class="small">
                <% if (site.supervisor) { %>
                  <i class="bi bi-person-gear me-1" style="color:var(--em-accent)"></i><%= site.supervisor.name %>
                <% } else { %>
                  <span class="text-muted"><%= t('common_unassigned') %></span>
                <% } %>
              </td>
              <td class="text-center">
                <a href="/workers?site_id=<%= site.id %>" class="badge text-decoration-none"
                   style="background:var(--eos-blue-50);color:var(--eos-blue-800);border:0.5px solid var(--eos-blue-100);font-size:.78rem">
                  <%= workerCount %> worker<%= workerCount !== 1 ? 's' : '' %>
                </a>
              </td>
              <td>
                <span class="badge" style="background:<%= isActive ? 'var(--eos-green-50)' : 'var(--em-surface-2)' %>;color:<%= isActive ? 'var(--eos-green-600)' : 'var(--em-ink-3)' %>;border:0.5px solid <%= isActive ? '#a8d57a' : 'var(--em-line)' %>;font-size:.72rem">
                  <%= site.status %>
                </span>
              </td>
              <td>
                <a href="/sites/<%= site.id %>/edit" class="btn btn-outline-secondary btn-sm" title="Edit site">
                  <i class="bi bi-pencil"></i>
                </a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/pagination', { pageData, query }) %>
<% } %>
