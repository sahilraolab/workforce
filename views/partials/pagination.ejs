<% if (pageData && pageData.totalPages > 1) { %>
<nav aria-label="Page navigation">
  <ul class="pagination pagination-sm mb-0">
    <li class="page-item <%= !pageData.hasPrev ? 'disabled' : '' %>">
      <a class="page-link" href="?<%= new URLSearchParams({...query, page: pageData.prevPage}).toString() %>">
        <i class="bi bi-chevron-left"></i>
      </a>
    </li>
    <% for (let i = Math.max(1, pageData.page - 2); i <= Math.min(pageData.totalPages, pageData.page + 2); i++) { %>
      <li class="page-item <%= i === pageData.page ? 'active' : '' %>">
        <a class="page-link" href="?<%= new URLSearchParams({...query, page: i}).toString() %>"><%= i %></a>
      </li>
    <% } %>
    <li class="page-item <%= !pageData.hasNext ? 'disabled' : '' %>">
      <a class="page-link" href="?<%= new URLSearchParams({...query, page: pageData.nextPage}).toString() %>">
        <i class="bi bi-chevron-right"></i>
      </a>
    </li>
  </ul>
</nav>
<% } %>
