<%- include('../partials/breadcrumb', { items: [{ label: t('companies_title') }] }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0 fw-bold"><i class="bi bi-building me-2 text-primary"></i><%= t('companies_title') %></h4>
  <a href="/admin/companies/new" class="btn btn-primary btn-sm"><i class="bi bi-plus me-1"></i><span class="d-none d-sm-inline"><%= t('companies_new_btn') %></span></a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <form class="row g-2 mb-3" method="GET">
      <div class="col-12 col-md-4">
        <input type="text" name="search" class="form-control form-control-sm" data-autosearch
          placeholder="<%= t('companies_search_placeholder') %>" value="<%= search %>">
      </div>
    </form>

    <% if (companies.length === 0) { %>
      <div class="text-center text-muted py-4"><%= t('companies_no_results') %></div>
    <% } else { %>

    <!-- Mobile: stacked cards -->
    <div class="d-md-none">
      <% companies.forEach(c => {
        const s = c.subscription;
        let endClass = '';
        if (s) {
          const daysLeft = Math.ceil((new Date(s.end_date) - new Date()) / (1000*60*60*24));
          endClass = daysLeft <= 7 ? 'text-danger fw-bold' : daysLeft <= 30 ? 'text-warning' : '';
        }
      %>
      <div class="worker-card mb-2">
        <div class="worker-card-top">
          <a href="/admin/companies/<%= c.id %>/edit" class="worker-card-name"><%= c.name %></a>
          <span class="badge <%= c.status === 'active' ? 'bg-success' : 'bg-danger' %>"><%= c.status %></span>
        </div>
        <div class="worker-card-meta">
          <span><i class="bi bi-tag"></i> <span class="text-capitalize"><%= c.plan %></span></span>
          <span><i class="bi bi-people"></i> <%= countMap[c.id] || 0 %><%= s && s.worker_limit ? ' / ' + s.worker_limit : '' %> <%= t('companies_col_workers') %></span>
        </div>
        <div class="worker-card-meta">
          <span><i class="bi bi-credit-card"></i> <%= s ? s.status : '—' %></span>
          <span class="<%= endClass %>"><i class="bi bi-calendar-x"></i> <%= s ? s.end_date : '—' %></span>
        </div>
        <div class="worker-card-actions">
          <a href="/admin/companies/<%= c.id %>/edit" class="btn btn-outline-secondary btn-sm w-100">
            <i class="bi bi-pencil me-1"></i><%= t('common_view') %>
          </a>
        </div>
      </div>
      <% }) %>
    </div>

    <!-- Desktop: table -->
    <div class="d-none d-md-block table-responsive">
      <table class="table table-hover table-sm">
        <thead class="table-light">
          <tr>
            <th><%= t('companies_col_company') %></th>
            <th><%= t('companies_col_plan') %></th>
            <th><%= t('companies_col_workers') %></th>
            <th><%= t('common_status') %></th>
            <th><%= t('subscriptions_title') %></th>
            <th><%= t('companies_col_sub_ends') %></th>
            <th><%= t('common_actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% companies.forEach(c => {
            const s = c.subscription;
            let endClass = '';
            if (s) {
              const daysLeft = Math.ceil((new Date(s.end_date) - new Date()) / (1000*60*60*24));
              endClass = daysLeft <= 7 ? 'text-danger fw-bold' : daysLeft <= 30 ? 'text-warning' : '';
            }
          %>
          <tr>
            <td class="fw-semibold"><%= c.name %></td>
            <td class="text-capitalize"><%= c.plan %></td>
            <td class="small"><%= countMap[c.id] || 0 %><%= s && s.worker_limit ? ' / ' + s.worker_limit : (s ? ' / ∞' : '') %></td>
            <td><span class="badge <%= c.status === 'active' ? 'bg-success' : 'bg-danger' %>"><%= c.status %></span></td>
            <td>
              <% if (s) { %>
                <span class="badge <%= s.status === 'active' ? 'bg-success' : 'bg-danger' %>"><%= s.status %></span>
              <% } else { %>—<% } %>
            </td>
            <td class="small <%= endClass %>"><%= s ? s.end_date : '—' %></td>
            <td>
              <a href="/admin/companies/<%= c.id %>/edit" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-pencil"></i>
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <div class="mt-2">
      <%- include('../partials/pagination', { pageData, query }) %>
    </div>
  </div>
</div>
