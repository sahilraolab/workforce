<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Wage Register — <%= company.name %> (<%= monthName %> <%= year %>)</title>
<style>
* { box-sizing:border-box; margin:0; padding:0; }
body { font-family:'Times New Roman',Times,serif; font-size:9pt; color:#000; background:#f0f0f0; }
.print-bar { background:#1e40af; padding:8px 16px; display:flex; align-items:center; gap:12px; }
.print-bar span { color:#fff; font-family:system-ui,sans-serif; font-size:13px; flex:1; }
.print-bar a { color:#bfdbfe; font-family:system-ui,sans-serif; font-size:12px; text-decoration:underline; }
.print-bar button { background:#fff; color:#1e40af; border:none; border-radius:6px; padding:6px 18px; font-size:13px; font-weight:700; cursor:pointer; }
.page { width:297mm; min-height:210mm; background:#fff; margin:12px auto; padding:10mm 12mm 8mm; box-shadow:0 2px 8px rgba(0,0,0,.18); }
.form-header { text-align:center; margin-bottom:6px; }
.form-header .title { font-size:12pt; font-weight:bold; }
.form-header .sub { font-size:9pt; }
.estab-line { font-size:9pt; margin-bottom:5px; border-bottom:0.5px solid #999; padding-bottom:3px; display:flex; gap:20px; flex-wrap:wrap; }
.estab-line strong { font-weight:bold; }
table.wreg { width:100%; border-collapse:collapse; font-size:8pt; }
table.wreg th, table.wreg td { border:0.6px solid #555; padding:2px 5px; text-align:right; vertical-align:middle; }
table.wreg .lft { text-align:left; }
table.wreg thead th { background:#eee; font-weight:bold; font-size:7.5pt; text-align:center; }
table.wreg .total-row td { font-weight:bold; background:#f0f7ff; }
table.wreg .no-payroll td { color:#9ca3af; font-style:italic; }
.sig-row { display:flex; justify-content:flex-end; margin-top:10px; font-size:8.5pt; }
@media print {
  body { background:#fff; }
  .print-bar { display:none !important; }
  .page { margin:0; box-shadow:none; padding:8mm 10mm 6mm; }
  @page { size:A4 landscape; margin:0; }
}
</style>
</head>
<body>
<div class="print-bar">
  <span>Wage Register — <%= company.name %>, <%= monthName %> <%= year %></span>
  <a href="/documents/generate">← Back</a>
  <button onclick="window.print()">⬇ Print / Save PDF</button>
</div>
<div class="page">
  <div class="form-header">
    <div class="title">WAGE REGISTER</div>
    <div class="sub">(As required under the Code on Wages, 2019 — Rule 55 / State equivalent)</div>
  </div>
  <div class="estab-line">
    <span><strong>Establishment:</strong> <%= company.name %></span>
    <span><strong>Site:</strong> <%= site ? site.name : 'All Sites' %></span>
    <span><strong>Wage Month:</strong> <%= monthName %> <%= year %></span>
    <span><strong>Generated:</strong> <%= generatedOn %></span>
  </div>
  <table class="wreg">
    <thead>
      <tr>
        <th class="lft" style="width:22px">S.No</th>
        <th class="lft" style="width:130px">Worker Name</th>
        <th class="lft" style="width:70px">Category</th>
        <th class="lft" style="width:80px">Site</th>
        <th style="width:32px">Days</th>
        <th style="width:60px">Basic (₹)</th>
        <th style="width:55px">OT (₹)</th>
        <th style="width:65px">Gross (₹)</th>
        <th style="width:55px">PF (₹)</th>
        <th style="width:55px">ESIC (₹)</th>
        <th style="width:55px">Other (₹)</th>
        <th style="width:65px">Net Pay (₹)</th>
        <th style="width:80px">Signature</th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(row => { %>
      <% if (!row.hasPayroll) { %>
      <tr class="no-payroll">
        <td><%= row.sno %></td>
        <td class="lft"><%= row.name %></td>
        <td class="lft"><%= row.category %></td>
        <td class="lft"><%= row.site %></td>
        <td colspan="9" style="text-align:center">— Payroll not generated —</td>
      </tr>
      <% } else { %>
      <tr>
        <td><%= row.sno %></td>
        <td class="lft"><%= row.name %></td>
        <td class="lft"><%= row.category %></td>
        <td class="lft"><%= row.site %></td>
        <td style="text-align:center"><%= row.daysPresent %></td>
        <td><%= fmtAmt(row.basicWage) %></td>
        <td><%= fmtAmt(row.otAmount) %></td>
        <td style="font-weight:600"><%= fmtAmt(row.gross) %></td>
        <td style="color:#991b1b"><%= fmtAmt(row.pf) %></td>
        <td style="color:#991b1b"><%= fmtAmt(row.esic) %></td>
        <td style="color:#991b1b"><%= fmtAmt(row.other) %></td>
        <td style="font-weight:700;color:#166534"><%= fmtAmt(row.net) %></td>
        <td></td>
      </tr>
      <% } %>
      <% }) %>
      <tr class="total-row">
        <td colspan="4" style="text-align:right">TOTAL</td>
        <td></td>
        <td></td>
        <td></td>
        <td><%= fmtAmt(totals.gross) %></td>
        <td><%= fmtAmt(totals.pf) %></td>
        <td><%= fmtAmt(totals.esic) %></td>
        <td><%= fmtAmt(totals.other) %></td>
        <td><%= fmtAmt(totals.net) %></td>
        <td></td>
      </tr>
    </tbody>
  </table>
  <div class="sig-row">
    <span>Signature of Employer / Manager: _________________________________ &nbsp; Date: ___________</span>
  </div>
</div>
</body>
</html>
