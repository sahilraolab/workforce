<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title><%= fh.num %> — Wage Register — <%= company.name %> (<%= monthName %> <%= year %>)</title>
<style>
* { box-sizing:border-box; margin:0; padding:0; }
body { font-family:'Times New Roman',Times,serif; font-size:8pt; color:#000; background:#f0f0f0; }
.print-bar { background:#1e40af; padding:8px 16px; display:flex; align-items:center; gap:12px; }
.print-bar span { color:#fff; font-family:system-ui,sans-serif; font-size:13px; flex:1; }
.print-bar a { color:#bfdbfe; font-family:system-ui,sans-serif; font-size:12px; text-decoration:underline; }
.print-bar button { background:#fff; color:#1e40af; border:none; border-radius:6px; padding:6px 18px; font-size:13px; font-weight:700; cursor:pointer; }
.page { width:297mm; min-height:210mm; background:#fff; margin:12px auto; padding:7mm 9mm 6mm; box-shadow:0 2px 8px rgba(0,0,0,.18); }
.form-header { text-align:center; border:1px solid #333; padding:4px 8px; margin-bottom:4px; }
.form-header .fnum { font-size:11pt; font-weight:bold; }
.form-header .frule { font-size:8pt; font-style:italic; }
.form-header .ftitle { font-size:9.5pt; font-weight:bold; margin-top:2px; text-transform:uppercase; }
.estab-block { border:0.6px solid #555; padding:3px 8px; margin-bottom:4px; font-size:7.5pt; display:flex; gap:20px; flex-wrap:wrap; }
.estab-block .ef { display:flex; gap:4px; align-items:baseline; }
.estab-block .el { font-weight:bold; white-space:nowrap; }
.estab-block .ev { border-bottom:0.5px solid #999; min-width:80px; }
table.wreg { width:100%; border-collapse:collapse; font-size:6.5pt; }
table.wreg th, table.wreg td { border:0.6px solid #555; padding:2px 2px; text-align:center; vertical-align:middle; }
table.wreg .lft { text-align:left; }
table.wreg .hdr-top { background:#1e3a5f; color:#fff; font-size:7pt; font-weight:bold; }
table.wreg .hdr-sub { background:#dde8ff; font-weight:bold; font-size:6pt; }
table.wreg .total-row td { font-weight:bold; background:#f0f7ff; }
table.wreg .no-payroll td { color:#9ca3af; font-style:italic; font-size:6pt; }
.sig-row { margin-top:8px; text-align:right; font-size:8pt; }
.footnote { font-size:6.5pt; margin-top:4px; border-top:0.5px solid #aaa; padding-top:3px; color:#444; font-style:italic; }
@media print {
  body { background:#fff; }
  .print-bar { display:none !important; }
  .page { margin:0; box-shadow:none; padding:5mm 7mm 4mm; }
  @page { size:A4 landscape; margin:0; }
}
</style>
</head>
<body>
<div class="print-bar">
  <span><%= fh.num %> — Wage Register — <%= company.name %>, <%= monthName %> <%= year %></span>
  <a href="/documents/generate">← Back</a>
  <button onclick="window.print()">⬇ Print / Save PDF</button>
</div>
<div class="page">
  <div class="form-header">
    <div class="fnum"><%= fh.num %></div>
    <div class="frule">(<%= fh.rule %>)</div>
    <div class="ftitle"><%= fh.title %></div>
  </div>
  <div class="estab-block">
    <div class="ef"><span class="el">Name of Establishment:</span><span class="ev"><%= company.name %></span></div>
    <div class="ef"><span class="el">Site:</span><span class="ev"><%= site ? site.name : 'All Sites' %></span></div>
    <div class="ef"><span class="el">Wage Month:</span><span class="ev"><%= monthName %> <%= year %></span></div>
    <div class="ef"><span class="el">Generated:</span><span class="ev"><%= generatedOn %></span></div>
    <div class="ef"><span class="el">As per:</span><span class="ev"><%= fh.note %></span></div>
  </div>
  <table class="wreg">
    <thead>
      <tr>
        <th class="hdr-top" rowspan="2" style="width:16px">(1)<br>Sl.</th>
        <th class="hdr-top" rowspan="2" style="width:110px">(2)&nbsp;(3)<br>Name of Employee</th>
        <th class="hdr-top" rowspan="2" style="width:58px">(4)<br>Designation</th>
        <th class="hdr-top" rowspan="2" style="width:38px">(8)<br>Days Worked</th>
        <th class="hdr-top" rowspan="2" style="width:30px">(9)<br>OT Hrs</th>
        <th class="hdr-top" colspan="3" style="">(10)–(12) Rate of Wages</th>
        <th class="hdr-top" colspan="5">(13)–(17) Amount of Wages Earned</th>
        <th class="hdr-top" colspan="6">(18)–(26) Deductions</th>
        <th class="hdr-top" rowspan="2" style="width:55px">(28)<br>Net Payment (₹)</th>
        <th class="hdr-top" rowspan="2" style="width:50px">(29)<br>Bank Txn ID / Receipt</th>
        <th class="hdr-top" rowspan="2" style="width:45px">(33)<br>Employer Sig.</th>
      </tr>
      <tr>
        <th class="hdr-sub" style="width:42px">Basic (₹)</th>
        <th class="hdr-sub" style="width:32px">DA (₹)</th>
        <th class="hdr-sub" style="width:42px">Allow. (₹)</th>
        <th class="hdr-sub" style="width:42px">Basic</th>
        <th class="hdr-sub" style="width:32px">DA</th>
        <th class="hdr-sub" style="width:42px">Allow.</th>
        <th class="hdr-sub" style="width:38px">OT</th>
        <th class="hdr-sub" style="width:50px">Total (₹)</th>
        <th class="hdr-sub" style="width:36px">EPF</th>
        <th class="hdr-sub" style="width:36px">ESIC</th>
        <th class="hdr-sub" style="width:32px">Adv.</th>
        <th class="hdr-sub" style="width:32px">Fine</th>
        <th class="hdr-sub" style="width:32px">Others</th>
        <th class="hdr-sub" style="width:44px">Total Ded.</th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(row => { %>
      <% if (!row.hasPayroll) { %>
      <tr class="no-payroll">
        <td><%= row.sno %></td>
        <td class="lft"><%= row.name %></td>
        <td class="lft"><%= row.category %></td>
        <td colspan="17" style="text-align:center">— Payroll not generated for this period —</td>
        <td></td><td></td>
      </tr>
      <% } else { %>
      <tr>
        <td><%= row.sno %></td>
        <td class="lft"><%= row.name %></td>
        <td class="lft" style="font-size:6pt"><%= row.category %></td>
        <td><%= row.daysPresent %></td>
        <td>—</td>
        <td><%= fmtAmt(row.basicWage) %></td>
        <td>—</td>
        <td>—</td>
        <td><%= fmtAmt(row.basicWage) %></td>
        <td>—</td>
        <td>—</td>
        <td><%= fmtAmt(row.otAmount) %></td>
        <td style="font-weight:600"><%= fmtAmt(row.gross) %></td>
        <td><%= fmtAmt(row.pf) %></td>
        <td><%= fmtAmt(row.esic) %></td>
        <td>—</td>
        <td>—</td>
        <td><%= fmtAmt(row.other) %></td>
        <td><%= fmtAmt(row.pf + row.esic + row.other) %></td>
        <td style="font-weight:700"><%= fmtAmt(row.net) %></td>
        <td></td>
        <td></td>
      </tr>
      <% } %>
      <% }) %>
      <tr class="total-row">
        <td colspan="3" style="text-align:right">TOTAL</td>
        <td></td><td></td>
        <td></td><td></td><td></td>
        <td></td><td></td><td></td><td></td>
        <td><%= fmtAmt(totals.gross) %></td>
        <td><%= fmtAmt(totals.pf) %></td>
        <td><%= fmtAmt(totals.esic) %></td>
        <td></td><td></td>
        <td><%= fmtAmt(totals.other) %></td>
        <td><%= fmtAmt(totals.pf + totals.esic + totals.other) %></td>
        <td><%= fmtAmt(totals.net) %></td>
        <td></td><td></td>
      </tr>
    </tbody>
  </table>
  <div class="sig-row">
    Signature of Employer / Authorised Representative: _________________________________ &nbsp;&nbsp; Date: _______________
  </div>
  <div class="footnote">
    * Columns for Society deduction, Income Tax, Insurance, Recovery of Damage/Loss left blank where not applicable. Column numbers in parentheses correspond to statutory form column numbering.<br>
    This register has been maintained in accordance with <%= fh.note %>. Must be preserved for 5 years after the last entry.
  </div>
</div>
</body>
</html>
