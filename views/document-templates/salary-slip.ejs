<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Salary Slip — <%= worker.name %> (<%= monthName %> <%= year %>)</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Times New Roman', Times, serif;
    font-size: 11pt;
    color: #000;
    background: #f0f0f0;
  }

  .page {
    width: 210mm;
    min-height: 148mm;
    background: #fff;
    margin: 16px auto;
    padding: 14mm 16mm 12mm;
    box-shadow: 0 2px 8px rgba(0,0,0,.18);
    position: relative;
  }

  /* ── Print button (hidden on print) ── */
  .print-bar {
    width: 210mm;
    margin: 0 auto 0;
    padding: 10px 16px;
    background: #1e40af;
    display: flex;
    align-items: center;
    gap: 12px;
    border-radius: 0;
  }
  .print-bar span { color: #fff; font-family: system-ui,sans-serif; font-size: 13px; flex:1; }
  .print-bar button {
    background: #fff; color: #1e40af; border: none; border-radius: 6px;
    padding: 6px 18px; font-size: 13px; font-weight: 700; cursor: pointer;
  }
  .print-bar a {
    color: #bfdbfe; font-family: system-ui,sans-serif; font-size: 12px;
    text-decoration: underline; cursor: pointer;
  }

  /* ── Form header ── */
  .form-header { text-align: center; margin-bottom: 6px; }
  .form-header .form-num { font-size: 14pt; font-weight: bold; letter-spacing: .05em; }
  .form-header .form-rule { font-size: 9.5pt; font-style: italic; margin-top: 1px; }
  .form-header .form-title { font-size: 13pt; font-weight: bold; margin-top: 4px; letter-spacing: .08em; text-transform: uppercase; }

  /* ── Establishment block ── */
  .estab-block { margin: 8px 0 6px; font-size: 9.5pt; border: 0.5px solid #555; padding: 5px 8px; }
  .estab-block table { width: 100%; border-collapse: collapse; }
  .estab-block td { padding: 2px 4px; vertical-align: top; }
  .estab-block .lbl { white-space: nowrap; font-weight: bold; width: 34%; }
  .estab-block .val { border-bottom: 0.5px solid #999; }

  /* ── Main table ── */
  .slip-table { width: 100%; border-collapse: collapse; font-size: 9.5pt; margin-top: 6px; }
  .slip-table th, .slip-table td {
    border: 0.8px solid #333;
    padding: 3px 6px;
    vertical-align: middle;
  }
  .slip-table .sl { width: 5%; text-align: center; font-weight: bold; }
  .slip-table .field-name { width: 42%; }
  .slip-table .field-val { width: 53%; }
  .slip-table .sub-sl { width: 5%; text-align: center; font-size: 9pt; }
  .slip-table .sub-name { width: 37%; padding-left: 14px; font-style: italic; }
  .slip-table .sub-col { width: 19%; text-align: right; }
  .slip-table .sub-hdr { font-size: 8.5pt; font-weight: bold; text-align: center; background: #f5f5f5; }
  .slip-table .total-row td { font-weight: bold; background: #fafafa; }
  .slip-table .net-row td { font-weight: bold; font-size: 10pt; background: #f0f7ff; }

  /* ── Signature row ── */
  .sig-row { display: flex; gap: 0; margin-top: 8px; }
  .sig-box { flex: 1; border: 0.8px solid #333; padding: 8px 10px 28px; font-size: 9.5pt; }
  .sig-box + .sig-box { border-left: none; }

  /* ── Footer note ── */
  .form-note { font-size: 8pt; font-style: italic; color: #444; margin-top: 8px; border-top: 0.5px solid #bbb; padding-top: 5px; }

  /* ── @media print ── */
  @media print {
    body { background: #fff; }
    .print-bar { display: none !important; }
    .page { margin: 0; box-shadow: none; padding: 10mm 14mm 8mm; }
    @page { size: A5 landscape; margin: 0; }
  }
</style>
</head>
<body>

<!-- Print bar (screen only) -->
<div class="print-bar">
  <span>Salary Slip — <%= worker.name %>, <%= monthName %> <%= year %></span>
  <a href="/workers/<%= worker.id %>">← Back to profile</a>
  <button onclick="window.print()">⬇ Print / Save PDF</button>
</div>

<div class="page">

  <!-- Form header -->
  <div class="form-header">
    <div class="form-num"><%= formNumber %></div>
    <div class="form-rule">(<%= formRule %>)</div>
    <div class="form-title">Wage Slip</div>
  </div>

  <!-- Establishment block -->
  <div class="estab-block">
    <table>
      <tr>
        <td class="lbl">Name of Establishment:</td>
        <td class="val"><%= establishment.name %></td>
        <td style="width:2%"></td>
        <td class="lbl" style="width:20%;white-space:nowrap">Wage Period:</td>
        <td class="val" style="width:22%"><%= wagePeriodFrom %> to <%= wagePeriodTo %></td>
      </tr>
      <tr>
        <td class="lbl">Address:</td>
        <td class="val" colspan="4"><%= establishment.address || '—' %></td>
      </tr>
    </table>
  </div>

  <!-- Main slip table -->
  <table class="slip-table">
    <tbody>

      <!-- Row 1: Name -->
      <tr>
        <td class="sl">1</td>
        <td class="field-name">Name of Employee</td>
        <td class="field-val"><%= worker.name %></td>
      </tr>

      <!-- Row 2: Father/Mother/Husband -->
      <tr>
        <td class="sl">2</td>
        <td class="field-name">Father's / Mother's / Husband's Name</td>
        <td class="field-val"><%= worker.fatherName || '—' %></td>
      </tr>

      <!-- Row 3: Designation -->
      <tr>
        <td class="sl">3</td>
        <td class="field-name">Designation / Nature of Work</td>
        <td class="field-val"><%= worker.designation || '—' %></td>
      </tr>

      <!-- Row 4: UAN -->
      <tr>
        <td class="sl">4</td>
        <td class="field-name">UAN (if applicable)</td>
        <td class="field-val"><%= worker.uan || '—' %></td>
      </tr>

      <!-- Row 5: Mode of payment -->
      <tr>
        <td class="sl">5</td>
        <td class="field-name">Mode of Payment</td>
        <td class="field-val"><%= worker.modeOfPayment %></td>
      </tr>

      <!-- Row 6: Days present -->
      <tr>
        <td class="sl">6</td>
        <td class="field-name">Total Days / Units of Work in Wage Period</td>
        <td class="field-val"><%= payroll.daysPresent %> days present out of <%= payroll.daysInMonth %> working days</td>
      </tr>

      <!-- Row 7: Wages earned — header row -->
      <tr>
        <td class="sl">7</td>
        <td class="field-name" colspan="2"><strong>Wages Earned</strong></td>
      </tr>

      <!-- Sub-header row for wages -->
      <tr>
        <td class="sub-sl"></td>
        <td class="sub-name sub-hdr">Component</td>
        <td class="sub-col sub-hdr" style="text-align:center">Amount (₹)</td>
      </tr>

      <!-- 7a: Basic -->
      <tr>
        <td class="sub-sl">(a)</td>
        <td class="sub-name">Basic Wages</td>
        <td class="sub-col"><%= fmtAmt(payroll.basicWage) %></td>
      </tr>

      <!-- 7b: DA -->
      <tr>
        <td class="sub-sl">(b)</td>
        <td class="sub-name">Dearness Allowance (DA)</td>
        <td class="sub-col"><%= fmtAmt(payroll.da) %></td>
      </tr>

      <!-- 7c: Other allowances -->
      <tr>
        <td class="sub-sl">(c)</td>
        <td class="sub-name">Other Allowances</td>
        <td class="sub-col"><%= fmtAmt(payroll.otherAllowances) %></td>
      </tr>

      <!-- 7d: OT wages -->
      <tr>
        <td class="sub-sl">(d)</td>
        <td class="sub-name">Overtime Wages (<%= payroll.otHours %> hrs)</td>
        <td class="sub-col"><%= fmtAmt(payroll.otAmount) %></td>
      </tr>

      <!-- 7e: Gross -->
      <tr class="total-row">
        <td class="sub-sl">(e)</td>
        <td class="sub-name" style="font-weight:bold;font-style:normal">Gross Wages</td>
        <td class="sub-col"><%= fmtAmt(payroll.gross) %></td>
      </tr>

      <!-- Row 8: Deductions — header -->
      <tr>
        <td class="sl">8</td>
        <td class="field-name" colspan="2"><strong>Deductions</strong></td>
      </tr>

      <!-- Sub-header for deductions -->
      <tr>
        <td class="sub-sl"></td>
        <td class="sub-name sub-hdr">Deduction Head</td>
        <td class="sub-col sub-hdr" style="text-align:center">Amount (₹)</td>
      </tr>

      <!-- 8a: PF -->
      <tr>
        <td class="sub-sl">(a)</td>
        <td class="sub-name">Provident Fund (PF)</td>
        <td class="sub-col"><%= fmtAmt(payroll.pfDeduction) %></td>
      </tr>

      <!-- 8b: ESIC -->
      <tr>
        <td class="sub-sl">(b)</td>
        <td class="sub-name">ESIC</td>
        <td class="sub-col"><%= fmtAmt(payroll.esicDeduction) %></td>
      </tr>

      <!-- 8c: Others -->
      <tr>
        <td class="sub-sl">(c)</td>
        <td class="sub-name">Other Deductions</td>
        <td class="sub-col"><%= fmtAmt(payroll.otherDeductions) %></td>
      </tr>

      <!-- 8d: Total deductions -->
      <tr class="total-row">
        <td class="sub-sl">(d)</td>
        <td class="sub-name" style="font-weight:bold;font-style:normal">Total Deductions</td>
        <td class="sub-col"><%= fmtAmt(payroll.totalDeductions) %></td>
      </tr>

      <!-- Row 9: Net wages -->
      <tr class="net-row">
        <td class="sl">9</td>
        <td class="field-name">Net Wages Paid</td>
        <td class="field-val"><strong><%= fmtAmt(payroll.netPay) %></strong> &nbsp;<span style="font-size:8.5pt;font-weight:normal;font-style:italic">(<%= payroll.netPayWords %>)</span></td>
      </tr>

      <!-- Row 10: Date of payment -->
      <tr>
        <td class="sl">10</td>
        <td class="field-name">Date of Payment</td>
        <td class="field-val"><%= payroll.dateOfPayment || '—' %></td>
      </tr>

    </tbody>
  </table>

  <!-- Signature row -->
  <div class="sig-row">
    <div class="sig-box">
      <strong>11. Signature / Stamp of Employer</strong>
      <div style="margin-top:20px;font-size:8.5pt;color:#555">Name &amp; Designation: ______________________________</div>
    </div>
    <div class="sig-box">
      <strong>12. Signature / Thumb Impression of Employee</strong>
      <div style="margin-top:20px;font-size:8.5pt;color:#555">Date of Receipt: ______________________________</div>
    </div>
  </div>

  <!-- Footer note -->
  <div class="form-note">
    Note: This wage slip has been generated in accordance with <%= formNote %>. The employer shall issue this wage slip to every employee before the expiry of the second working day following the last day of the wage period.
  </div>

</div><!-- /.page -->

</body>
</html>
