<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (typeof title !== 'undefined' ? title + ' — ' : '') %><%= APP_NAME %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">
  <%- style %>
</head>
<body>

<% if (user) { %>
  <%- include('partials/navbar') %>
  <div id="layout-wrapper">
    <%- include('partials/sidebar') %>
    <main id="main-content">
      <%- include('partials/alerts') %>
      <%- body %>
    </main>
  </div>
  <%- include('partials/bottomnav') %>
<% } else { %>
  <%- body %>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/alpinejs@3.13.5/dist/cdn.min.js" defer></script>
<script src="/js/app.js"></script>
<script>
  // Mobile "More" sheet — full nav parity with the desktop sidebar
  const moreBtn = document.getElementById('bn-more-btn');
  const moreSheet = document.getElementById('more-sheet');
  const moreOverlay = document.getElementById('more-overlay');
  function closeMoreSheet() {
    moreSheet?.classList.remove('open');
    moreOverlay?.classList.remove('open');
  }
  if (moreBtn) {
    moreBtn.addEventListener('click', () => {
      moreSheet.classList.toggle('open');
      moreOverlay.classList.toggle('open');
    });
    moreOverlay.addEventListener('click', closeMoreSheet);
  }
</script>
<%- script %>
</body>
</html>
