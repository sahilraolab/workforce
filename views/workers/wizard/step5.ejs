<%- include('./_progress') %>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <h5 class="mb-0 fw-bold"><i class="bi bi-clipboard-check me-2 text-primary"></i><%= t('wiz_step5_title') %></h5>
    <span class="badge bg-info"><%= t('wiz_step5_verify_badge') %></span>
  </div>
  <div class="card-body p-4">

    <!-- Personal Details -->
    <h6 class="fw-bold text-muted text-uppercase small mb-2"><%= t('wiz_step5_personal') %></h6>
    <div class="row mb-4 g-2">
      <div class="col-md-4"><strong><%= t('wiz_label_full_name') %>:</strong> <%= draft.name %></div>
      <div class="col-md-4"><strong><%= t('wiz_label_father_name') %>:</strong> <%= draft.father_name %></div>
      <div class="col-md-4"><strong><%= t('wiz_label_dob') %>:</strong> <%= draft.dob %></div>
      <div class="col-md-4"><strong><%= t('wiz_label_gender') %>:</strong> <%= draft.gender %></div>
      <div class="col-md-4"><strong><%= t('wiz_label_aadhaar') %>:</strong> ••••••••<%= (draft.aadhaar || '').slice(-4) %></div>
      <div class="col-md-4"><strong>PAN:</strong> <%= draft.pan_number ? '••••••' + (draft.pan_number).slice(-4) : t('wiz_step5_not_applicable') %></div>
      <div class="col-md-4"><strong><%= t('wiz_label_mobile') %>:</strong> <%= draft.mobile %></div>
      <div class="col-md-4"><strong><%= t('wiz_label_marital_status') %>:</strong> <%= draft.marital_status %></div>
      <div class="col-md-8"><strong><%= t('wiz_label_address_aadhaar') %>:</strong> <%= draft.address_aadhaar %></div>
    </div>

    <!-- Employment Details -->
    <h6 class="fw-bold text-muted text-uppercase small mb-2"><%= t('wiz_step5_employment') %></h6>
    <div class="row mb-4 g-2">
      <div class="col-md-3"><strong><%= t('wiz_label_category') %>:</strong> <%= draft.category %></div>
      <div class="col-md-3"><strong><%= t('wiz_label_zone') %>:</strong> <%= draft.zone %></div>
      <div class="col-md-3"><strong><%= t('wiz_label_wage_rate') %>:</strong> ₹<%= draft.wage_rate %></div>
      <div class="col-md-3"><strong><%= t('wiz_label_doj') %>:</strong> <%= draft.doj %></div>
      <div class="col-md-3"><strong>UAN:</strong> <%= draft.uan ? '••••••••' + (draft.uan).slice(-4) : t('wiz_step5_uan_not_provided') %></div>
      <div class="col-md-3"><strong>ESIC:</strong> <%= draft.esic_applicable === 'yes' ? 'Yes — ••••' + (draft.esic_number || '').slice(-4) : t('wiz_step5_not_applicable') %></div>
    </div>

    <!-- Documents -->
    <h6 class="fw-bold text-muted text-uppercase small mb-2"><%= t('wiz_step5_documents') %></h6>
    <div class="row mb-4 g-2">
      <% const uploads = draft._uploads || {}; %>
      <% const docLabels = {
        aadhaar: t('wiz_label_aadhaar_card'),
        aadhaar_back: 'Aadhaar Card (Back)',
        pan_card: 'PAN Card',
        passport_photo: t('wiz_label_passport_photo'),
        bank_passbook: t('wiz_label_bank_passbook'),
        uan_card: t('wiz_label_uan_card'),
        esic_card: t('wiz_label_esic_card')
      }; %>
      <% Object.entries(docLabels).forEach(([key, label]) => { %>
      <div class="col-md-4">
        <% if (uploads[key]) { %>
          <span class="badge bg-success me-1"><i class="bi bi-check"></i></span>
        <% } else { %>
          <span class="badge bg-secondary me-1"><i class="bi bi-dash"></i></span>
        <% } %>
        <%= label %>
      </div>
      <% }) %>
    </div>

    <!-- Bank -->
    <h6 class="fw-bold text-muted text-uppercase small mb-2"><%= t('wiz_step5_bank') %></h6>
    <div class="row mb-4 g-2">
      <div class="col-md-4"><strong><%= t('wiz_label_bank_account') %>:</strong> ••••<%= (draft.bank_account || '').slice(-4) %></div>
      <div class="col-md-4"><strong><%= t('wiz_label_ifsc') %>:</strong> <%= draft.ifsc_code || t('wiz_step5_uan_not_provided') %></div>
    </div>

    <!-- Family Members -->
    <% if (draft._familyMembers && draft._familyMembers.length > 0) { %>
    <h6 class="fw-bold text-muted text-uppercase small mb-2"><%= t('wiz_step5_family') %></h6>
    <table class="table table-sm table-bordered mb-4">
      <thead class="table-light">
        <tr>
          <th><%= t('wiz_step5_relation') %></th>
          <th><%= t('wiz_label_name') %></th>
          <th><%= t('wiz_step5_aadhaar_col') %></th>
          <th><%= t('wiz_step5_photo_col') %></th>
        </tr>
      </thead>
      <tbody>
        <% draft._familyMembers.forEach(m => { %>
        <tr>
          <td class="text-capitalize"><%= m.relation %></td>
          <td><%= m.name %></td>
          <td><%= m.aadhaar ? '••••••••' + (m.aadhaar).slice(-4) : '—' %></td>
          <td><%= m.photo ? '<span class="badge bg-success">' + t('wiz_step5_photo_yes') + '</span>' : '—' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>

    <div class="alert alert-warning small">
      <i class="bi bi-exclamation-triangle me-1"></i>
      <%= t('wiz_step5_validation_note') %>
    </div>

    <form action="/workers/register/submit" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="d-flex justify-content-between align-items-center gap-2">
        <div class="d-flex gap-2">
          <a href="/workers/register/step4" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i><%= t('wiz_btn_back') %>
          </a>
          <a href="/workers/register/exit" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-x-lg me-1"></i><%= t('wiz_btn_exit') %>
          </a>
        </div>
        <button type="submit" class="btn btn-success">
          <i class="bi bi-check-circle me-2"></i><%= t('wiz_btn_submit') %>
        </button>
      </div>
    </form>
  </div>
</div>
