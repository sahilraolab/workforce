<%- include('./_progress') %>

<div class="card">
  <div class="card-header">
    <span><i class="bi bi-briefcase-fill me-2" style="color:var(--amber)"></i><%= t('wiz_step2_title') %></span>
    <span class="voice-hint"><i class="bi bi-mic-fill"></i> <%= t('wiz_voice_hint') %></span>
  </div>
  <div class="card-body">

    <% if (errors && errors.length > 0) { %>
    <div class="alert alert-danger mb-3">
      <i class="bi bi-exclamation-circle-fill"></i>
      <ul class="mb-0" style="padding-left:1rem;font-size:.83rem"><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul>
    </div>
    <% } %>

    <script>
      const WAGE_MAP = {};
      <% wageMasters.forEach(wm => { %>
      WAGE_MAP['<%= wm.category %>|<%= wm.zone %>'] = '<%= wm.wage_rate %>';
      <% }) %>
      const MSG_AUTO_FILLED = <%= JSON.stringify(t('wiz_auto_filled_wage')) %>;
      const MSG_NO_RATE = <%= JSON.stringify(t('wiz_no_standard_rate')) %>;
    </script>

    <form action="/workers/register/step2" method="POST" novalidate x-data="employmentForm()">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">
            <i class="bi bi-layers text-muted"></i> <%= t('wiz_label_category') %> <span class="req">*</span>
          </label>
          <select name="category" class="form-select" x-model="category" @change="lookupWage()" required>
            <option value=""><%= t('wiz_select_category_placeholder') %></option>
            <% ['Unskilled','Semi-Skilled','Skilled','Executive','Manager'].forEach(c => { %>
              <option value="<%= c %>" <%= draft.category === c ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">
            <i class="bi bi-pin-map text-muted"></i> <%= t('wiz_label_zone') %> <span class="req">*</span>
          </label>
          <%
            const _zones = [...new Set((wageMasters||[]).map(wm => wm.zone).filter(Boolean))];
          %>
          <input type="text" name="zone" list="wiz-zone-list" class="form-control"
                 value="<%= draft.zone || '' %>" placeholder="e.g. Zone 1, North"
                 autocomplete="off" x-model="zone" @change="lookupWage()" required>
          <datalist id="wiz-zone-list">
            <% _zones.forEach(z => { %><option value="<%= z %>"><% }) %>
          </datalist>
        </div>

        <div class="col-md-4">
          <label class="form-label">
            <i class="bi bi-currency-rupee text-muted"></i> <%= t('wiz_label_wage_rate') %> <span class="req">*</span>
            <span class="voice-hint"><i class="bi bi-mic-fill"></i> <%= t('wiz_speak') %></span>
          </label>
          <div class="input-voice-wrap">
            <div class="input-group">
              <span class="input-group-text">₹</span>
              <input type="number" name="wage_rate" class="form-control" x-model="wageRate"
                step="0.01" min="0" required value="<%= draft.wage_rate || '' %>"
                style="padding-right:2.6rem">
            </div>
            <button class="mic-btn" type="button" title="Speak to fill"><i class="bi bi-mic-fill"></i></button>
          </div>
          <div class="form-text" x-show="wageSource" x-text="wageSource"></div>
        </div>

        <div class="col-md-4">
          <label class="form-label">
            <i class="bi bi-calendar2-check text-muted"></i> <%= t('wiz_label_doj') %> <span class="req">*</span>
          </label>
          <input type="date" name="doj" class="form-control" value="<%= draft.doj || '' %>" required>
        </div>

        <div class="col-md-4">
          <label class="form-label">
            <i class="bi bi-person-badge text-muted"></i> <%= t('wiz_label_uan') %>
            <span class="voice-hint"><i class="bi bi-mic-fill"></i> <%= t('wiz_speak') %></span>
          </label>
          <div class="input-voice-wrap">
            <input type="text" name="uan" class="form-control" value="<%= draft.uan || '' %>"
              pattern="\d{12}" maxlength="12" placeholder="12-digit UAN">
            <button class="mic-btn" type="button" title="Speak to fill"><i class="bi bi-mic-fill"></i></button>
          </div>
          <div class="form-text"><%= t('wiz_uan_hint') %></div>
        </div>

        <div class="col-md-4" x-data="{ esic: '<%= draft.esic_applicable || 'no' %>' }">
          <label class="form-label">
            <i class="bi bi-hospital text-muted"></i> <%= t('wiz_label_esic_applicable') %> <span class="req">*</span>
          </label>
          <div class="d-flex gap-3 mt-1">
            <div class="form-check">
              <input class="form-check-input" type="radio" name="esic_applicable" value="yes"
                x-model="esic" id="esicYes" <%= draft.esic_applicable === 'yes' ? 'checked' : '' %>>
              <label class="form-check-label" for="esicYes">Yes</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="esic_applicable" value="no"
                x-model="esic" id="esicNo" <%= draft.esic_applicable !== 'yes' ? 'checked' : '' %>>
              <label class="form-check-label" for="esicNo">No</label>
            </div>
          </div>
          <div class="mt-2" x-show="esic === 'yes'" x-cloak>
            <label class="form-label" style="font-size:.8rem">
              <%= t('wiz_label_esic_number') %> <span class="req">*</span>
              <span class="voice-hint"><i class="bi bi-mic-fill"></i> <%= t('wiz_speak') %></span>
            </label>
            <div class="input-voice-wrap">
              <input type="text" name="esic_number" class="form-control form-control-sm"
                value="<%= draft.esic_number || '' %>"
                pattern="\d{17}" maxlength="17" placeholder="17-digit ESIC number"
                :required="esic === 'yes'">
              <button class="mic-btn" type="button" title="Speak to fill"><i class="bi bi-mic-fill"></i></button>
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-4 gap-2">
        <div class="d-flex gap-2">
          <a href="/workers/register" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i><%= t('wiz_btn_back') %>
          </a>
          <button type="submit" formaction="/workers/register/save-draft" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-floppy me-1"></i><%= t('wiz_btn_save_exit') %>
          </button>
        </div>
        <button type="submit" class="btn btn-primary">
          <%= t('wiz_btn_next_documents') %> <i class="bi bi-arrow-right ms-1"></i>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function employmentForm() {
  return {
    category: '<%= draft.category || '' %>',
    zone: '<%= draft.zone || '' %>',
    wageRate: '<%= draft.wage_rate || '' %>',
    wageSource: '',
    lookupWage() {
      const key = `${this.category}|${this.zone}`;
      if (WAGE_MAP[key]) {
        this.wageRate = WAGE_MAP[key];
        this.wageSource = MSG_AUTO_FILLED.replace('{{rate}}', WAGE_MAP[key]);
      } else if (this.category && this.zone) {
        this.wageSource = MSG_NO_RATE;
      }
    }
  };
}
</script>
