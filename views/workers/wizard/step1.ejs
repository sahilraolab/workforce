<%- include('./_progress') %>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white"><h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-text me-2 text-primary"></i><%= t('wiz_step1_title') %></h5></div>
  <div class="card-body p-4">

    <div class="alert alert-info small">
      <i class="bi bi-info-circle me-1"></i>
      <%= t('wiz_step3_formats_hint') %>
      We'll read what we can off the Aadhaar, PAN, and bank passbook photos and pre-fill the next steps for you — only values we're confident about get filled in, so please still check them.
    </div>

    <form action="/workers/register/step1?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST" enctype="multipart/form-data" novalidate>

      <div class="row g-4">
        <!-- Aadhaar Card -->
        <div class="col-md-6">
          <div class="card h-100">
            <div class="card-body">
              <label class="form-label fw-semibold d-block">
                <%= t('wiz_label_aadhaar_card') %> (Front) <span class="text-danger">*</span>
                <% if (draft._uploads && draft._uploads.aadhaar) { %><span class="badge bg-success ms-2"><%= t('wiz_doc_uploaded') %></span><% } %>
              </label>
              <input type="file" name="aadhaar" class="form-control" accept="image/*,application/pdf">
              <div class="form-text">Take a photo or choose a file. PDF, JPG, or PNG. Max 2MB.</div>
            </div>
          </div>
        </div>

        <!-- Aadhaar Card — back side -->
        <div class="col-md-6">
          <div class="card h-100">
            <div class="card-body">
              <label class="form-label fw-semibold d-block">
                Aadhaar Card (Back) <span class="text-danger">*</span>
                <% if (draft._uploads && draft._uploads.aadhaar_back) { %><span class="badge bg-success ms-2"><%= t('wiz_doc_uploaded') %></span><% } %>
              </label>
              <input type="file" name="aadhaar_back" class="form-control" accept="image/*,application/pdf">
              <div class="form-text">Take a photo or choose a file. PDF, JPG, or PNG. Max 2MB. This is where the address is read from.</div>
            </div>
          </div>
        </div>

        <!-- PAN Card (optional) -->
        <div class="col-md-6">
          <div class="card h-100">
            <div class="card-body">
              <label class="form-label fw-semibold d-block">
                PAN Card <span class="badge bg-secondary ms-2"><%= t('wiz_doc_optional') %></span>
                <% if (draft._uploads && draft._uploads.pan_card) { %><span class="badge bg-success ms-2"><%= t('wiz_doc_uploaded') %></span><% } %>
              </label>
              <input type="file" name="pan_card" class="form-control" accept="image/*,application/pdf">
              <div class="form-text">Take a photo or choose a file. PDF, JPG, or PNG. Max 2MB.</div>
            </div>
          </div>
        </div>

        <!-- Passport Photo -->
        <div class="col-md-6">
          <div class="card h-100">
            <div class="card-body">
              <label class="form-label fw-semibold d-block">
                <%= t('wiz_label_passport_photo') %> <span class="text-danger">*</span>
                <% if (draft._uploads && draft._uploads.passport_photo) { %><span class="badge bg-success ms-2"><%= t('wiz_doc_uploaded') %></span><% } %>
              </label>
              <input type="file" name="passport_photo" class="form-control"
                accept="image/*"
                data-max-kb="100"
                data-warn-id="photo-warn"
                data-show-size="photo-size">
              <div class="form-text">Take a photo or choose a file. JPG or PNG only. <strong>Max 100KB.</strong></div>
              <div id="photo-warn" class="file-size-warn" style="display:none"></div>
              <div id="photo-size" class="small text-muted mt-1"></div>
            </div>
          </div>
        </div>

        <!-- Bank Passbook / Cancelled Cheque -->
        <div class="col-md-6">
          <div class="card h-100">
            <div class="card-body">
              <label class="form-label fw-semibold d-block">
                <%= t('wiz_label_bank_passbook') %> <span class="text-danger">*</span>
                <% if (draft._uploads && draft._uploads.bank_passbook) { %><span class="badge bg-success ms-2"><%= t('wiz_doc_uploaded') %></span><% } %>
              </label>
              <input type="file" name="bank_passbook" class="form-control" accept="image/*,application/pdf">
              <div class="form-text">Take a photo or choose a file. PDF or JPG. Max 2MB.</div>
            </div>
          </div>
        </div>

        <!-- UAN Card (optional) -->
        <div class="col-md-6">
          <div class="card h-100">
            <div class="card-body">
              <label class="form-label fw-semibold d-block">
                <%= t('wiz_label_uan_card') %> <span class="badge bg-secondary ms-2"><%= t('wiz_doc_optional') %></span>
                <% if (draft._uploads && draft._uploads.uan_card) { %><span class="badge bg-success ms-2"><%= t('wiz_doc_uploaded') %></span><% } %>
              </label>
              <input type="file" name="uan_card" class="form-control" accept="image/*,application/pdf">
              <div class="form-text">Take a photo or choose a file. PDF, JPG, or PNG. Max 2MB.</div>
            </div>
          </div>
        </div>

        <!-- ESIC Card (optional here — applicability isn't decided until the Employment step) -->
        <div class="col-md-6">
          <div class="card h-100">
            <div class="card-body">
              <label class="form-label fw-semibold d-block">
                <%= t('wiz_label_esic_card') %> <span class="badge bg-secondary ms-2"><%= t('wiz_doc_optional') %></span>
                <% if (draft._uploads && draft._uploads.esic_card) { %><span class="badge bg-success ms-2"><%= t('wiz_doc_uploaded') %></span><% } %>
              </label>
              <input type="file" name="esic_card" class="form-control" accept="image/*,application/pdf">
              <div class="form-text">Take a photo or choose a file. PDF, JPG, or PNG. Max 2MB. Only needed if ESIC applies — you'll confirm that on the Employment step.</div>
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-4 gap-2">
        <div class="d-flex gap-2">
          <a href="/workers/register/exit" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-x-lg me-1"></i><%= t('wiz_btn_exit') %>
          </a>
          <button type="submit" formaction="/workers/register/save-draft" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-floppy me-1"></i><%= t('wiz_btn_save_exit') %>
          </button>
        </div>
        <button type="submit" class="btn btn-primary">
          <%= t('wiz_btn_next_personal') %> <i class="bi bi-arrow-right ms-1"></i>
        </button>
      </div>
    </form>
  </div>
</div>
