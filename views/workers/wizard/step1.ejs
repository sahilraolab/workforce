<%- include('./_progress') %>

<div class="card">
  <div class="card-header">
    <span><i class="bi bi-person-fill me-2" style="color:var(--brand)"></i><%= t('wiz_step1_title') %></span>
    <span class="voice-hint"><i class="bi bi-mic-fill"></i> <%= t('wiz_voice_hint') %></span>
  </div>
  <div class="card-body">

    <% if (errors && errors.length > 0) { %>
    <div class="alert alert-danger mb-3">
      <i class="bi bi-exclamation-circle-fill"></i>
      <ul class="mb-0" style="padding-left:1rem;font-size:.83rem"><% errors.forEach(e => { %><li><%= e.msg %></li><% }) %></ul>
    </div>
    <% } %>

    <form action="/workers/register/step1" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">
            <i class="bi bi-geo-alt text-muted"></i> <%= t('wiz_label_site') %> <span class="req">*</span>
          </label>
          <select name="site_id" class="form-select" required <% if (user.role === 'site_supervisor') { %>disabled<% } %>>
            <option value=""><%= t('wiz_select_site_placeholder') %></option>
            <% sites.forEach(s => { %>
              <option value="<%= s.id %>" <%= (draft.site_id == s.id || defaultSiteId == s.id) ? 'selected' : '' %>>
                <%= s.name %>
              </option>
            <% }) %>
          </select>
          <% if (user.role === 'site_supervisor') { %>
            <input type="hidden" name="site_id" value="<%= defaultSiteId %>">
          <% } %>
        </div>

        <div class="col-md-6">
          <label class="form-label">
            <i class="bi bi-person text-muted"></i> <%= t('wiz_label_full_name') %> <span class="req">*</span>
            <span class="voice-hint"><i class="bi bi-mic-fill"></i> <%= t('wiz_speak') %></span>
          </label>
          <div class="input-voice-wrap">
            <input type="text" name="name" class="form-control" value="<%= draft.name || '' %>"
              required placeholder="<%= t('wiz_label_full_name') %>">
            <button class="mic-btn" type="button" title="Speak to fill"><i class="bi bi-mic-fill"></i></button>
          </div>
        </div>

        <div class="col-md-6">
          <label class="form-label">
            <i class="bi bi-person text-muted"></i> <%= t('wiz_label_father_name') %> <span class="req">*</span>
            <span class="voice-hint"><i class="bi bi-mic-fill"></i> <%= t('wiz_speak') %></span>
          </label>
          <div class="input-voice-wrap">
            <input type="text" name="father_name" class="form-control" value="<%= draft.father_name || '' %>" required>
            <button class="mic-btn" type="button" title="Speak to fill"><i class="bi bi-mic-fill"></i></button>
          </div>
        </div>

        <div class="col-md-3">
          <label class="form-label">
            <i class="bi bi-calendar2 text-muted"></i> <%= t('wiz_label_dob') %> <span class="req">*</span>
          </label>
          <input type="date" name="dob" class="form-control" value="<%= draft.dob || '' %>"
            required max="<%= new Date(Date.now() - 18*365*24*60*60*1000).toISOString().split('T')[0] %>">
        </div>

        <div class="col-md-3">
          <label class="form-label">
            <i class="bi bi-gender-ambiguous text-muted"></i> <%= t('wiz_label_gender') %> <span class="req">*</span>
          </label>
          <select name="gender" class="form-select" required>
            <option value=""><%= t('wiz_select_placeholder') %></option>
            <option value="Male" <%= draft.gender === 'Male' ? 'selected' : '' %>><%= t('wiz_gender_male') %></option>
            <option value="Female" <%= draft.gender === 'Female' ? 'selected' : '' %>><%= t('wiz_gender_female') %></option>
            <option value="Other" <%= draft.gender === 'Other' ? 'selected' : '' %>><%= t('wiz_gender_other') %></option>
          </select>
        </div>

        <div class="col-md-6">
          <label class="form-label">
            <i class="bi bi-credit-card text-muted"></i> <%= t('wiz_label_aadhaar') %> <span class="req">*</span>
            <span class="voice-hint"><i class="bi bi-mic-fill"></i> <%= t('wiz_speak') %></span>
          </label>
          <div class="input-voice-wrap">
            <input type="text" name="aadhaar" class="form-control" value="<%= draft.aadhaar || '' %>"
              pattern="\d{12}" maxlength="12" placeholder="12-digit Aadhaar" required autocomplete="off">
            <button class="mic-btn" type="button" title="Speak to fill"><i class="bi bi-mic-fill"></i></button>
          </div>
          <div class="form-text"><%= t('wiz_aadhaar_hint') %></div>
        </div>

        <div class="col-md-6">
          <label class="form-label">
            <i class="bi bi-telephone text-muted"></i> <%= t('wiz_label_mobile') %> <span class="req">*</span>
            <span class="voice-hint"><i class="bi bi-mic-fill"></i> <%= t('wiz_speak') %></span>
          </label>
          <div class="input-voice-wrap">
            <input type="tel" name="mobile" class="form-control" value="<%= draft.mobile || '' %>"
              pattern="\d{10}" maxlength="10" placeholder="10-digit mobile" required>
            <button class="mic-btn" type="button" title="Speak to fill"><i class="bi bi-mic-fill"></i></button>
          </div>
        </div>

        <div class="col-md-6">
          <label class="form-label">
            <i class="bi bi-envelope text-muted"></i> <%= t('wiz_label_email') %>
            <span class="voice-hint"><i class="bi bi-mic-fill"></i> <%= t('wiz_speak') %></span>
          </label>
          <div class="input-voice-wrap">
            <input type="email" name="email" class="form-control" value="<%= draft.email || '' %>">
            <button class="mic-btn" type="button" title="Speak to fill"><i class="bi bi-mic-fill"></i></button>
          </div>
        </div>

        <div class="col-md-6">
          <label class="form-label">
            <i class="bi bi-heart text-muted"></i> <%= t('wiz_label_marital_status') %> <span class="req">*</span>
          </label>
          <select name="marital_status" class="form-select" required>
            <option value=""><%= t('wiz_select_placeholder') %></option>
            <option value="Single" <%= draft.marital_status === 'Single' ? 'selected' : '' %>><%= t('wiz_marital_single') %></option>
            <option value="Married" <%= draft.marital_status === 'Married' ? 'selected' : '' %>><%= t('wiz_marital_married') %></option>
            <option value="Widowed" <%= draft.marital_status === 'Widowed' ? 'selected' : '' %>><%= t('wiz_marital_widowed') %></option>
            <option value="Divorced" <%= draft.marital_status === 'Divorced' ? 'selected' : '' %>><%= t('wiz_marital_divorced') %></option>
          </select>
        </div>

        <div class="col-12">
          <label class="form-label">
            <i class="bi bi-house text-muted"></i> <%= t('wiz_label_address_aadhaar') %> <span class="req">*</span>
            <span class="voice-hint"><i class="bi bi-mic-fill"></i> <%= t('wiz_speak') %></span>
          </label>
          <div class="input-voice-wrap">
            <textarea name="address_aadhaar" class="form-control" rows="2" required
              style="padding-right:2.6rem"><%= draft.address_aadhaar || '' %></textarea>
            <button class="mic-btn" type="button" title="Speak to fill" style="top:1rem;transform:none"><i class="bi bi-mic-fill"></i></button>
          </div>
        </div>

        <div class="col-12">
          <label class="form-label">
            <i class="bi bi-house-door text-muted"></i> <%= t('wiz_label_present_address') %>
            <span class="voice-hint"><i class="bi bi-mic-fill"></i> <%= t('wiz_speak') %></span>
          </label>
          <div class="input-voice-wrap">
            <textarea name="present_address" class="form-control" rows="2"
              style="padding-right:2.6rem"><%= draft.present_address || '' %></textarea>
            <button class="mic-btn" type="button" title="Speak to fill" style="top:1rem;transform:none"><i class="bi bi-mic-fill"></i></button>
          </div>
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-4 gap-2">
        <div class="d-flex gap-2">
          <a href="/workers/register/exit" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-x-lg me-1"></i><%= t('wiz_btn_exit') %>
          </a>
          <button type="submit" formaction="/workers/register/save-draft" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-floppy me-1"></i><%= t('wiz_btn_save_exit') %>
          </button>
        </div>
        <button type="submit" class="btn btn-primary">
          <%= t('wiz_btn_next_employment') %> <i class="bi bi-arrow-right ms-1"></i>
        </button>
      </div>
    </form>
  </div>
</div>
