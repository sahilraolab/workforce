<%- include('../partials/breadcrumb', { items: [{ label: t('workers_title'), href: '/workers' }, { label: worker.name }] }) %>

<%
  const initials = worker.name ? worker.name.split(' ').map(p => p[0]).join('').toUpperCase().slice(0,2) : '?';
  const docLabels = { aadhaar: 'Aadhaar Card', passport_photo: 'Passport Photo', bank_passbook: 'Bank Passbook', uan_card: 'UAN Card', esic_card: 'ESIC Card' };
  const docIcons  = { aadhaar: 'bi-fingerprint', passport_photo: 'bi-image', bank_passbook: 'bi-bank', uan_card: 'bi-card-list', esic_card: 'bi-heart-pulse' };
%>

<!-- Profile header card -->
<div class="card mb-3" style="border-radius:14px;overflow:hidden">
  <div style="background:linear-gradient(135deg,var(--em-accent),var(--em-accent-dark));padding:1.5rem 1.25rem 1rem">
    <div class="d-flex align-items-center gap-3 mb-3">
      <a href="/workers" class="btn btn-sm" style="background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);color:#fff">
        <i class="bi bi-arrow-left"></i>
      </a>
      <!-- Large avatar -->
      <div style="width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,.2);border:2px solid rgba(255,255,255,.4);display:flex;align-items:center;justify-content:center;font-size:1.3rem;font-weight:700;color:#fff;flex-shrink:0"><%= initials %></div>
      <div style="flex:1;min-width:0">
        <div style="font-size:1.1rem;font-weight:700;color:#fff;line-height:1.2"><%= worker.name %></div>
        <div style="font-size:.78rem;color:rgba(255,255,255,.75);margin-top:2px">
          <%= worker.employment ? worker.employment.category + ' · ' + worker.employment.zone : '—' %>
          <% if (worker.site) { %> · <%= worker.site.name %><% } %>
        </div>
      </div>
      <span class="badge <%= worker.status === 'active' ? 'bg-success' : worker.status === 'draft' ? 'bg-warning' : 'bg-secondary' %>" style="font-size:.72rem">
        <% if (worker.status === 'active') { %><i class="bi bi-circle-fill" style="font-size:5px"></i><% } %>
        <%= worker.status %>
      </span>
    </div>

    <!-- Quick stat chips -->
    <div class="d-flex gap-2 flex-wrap">
      <div style="background:rgba(255,255,255,.12);border:0.5px solid rgba(255,255,255,.2);border-radius:8px;padding:8px 14px">
        <div style="font-size:.65rem;color:rgba(255,255,255,.65);text-transform:uppercase;letter-spacing:.05em">Joined</div>
        <div style="font-size:.9rem;font-weight:600;color:#fff"><%= worker.employment ? worker.employment.doj : '—' %></div>
      </div>
      <div style="background:rgba(255,255,255,.12);border:0.5px solid rgba(255,255,255,.2);border-radius:8px;padding:8px 14px">
        <div style="font-size:.65rem;color:rgba(255,255,255,.65);text-transform:uppercase;letter-spacing:.05em">Daily wage</div>
        <div style="font-size:.9rem;font-weight:600;color:#fff"><%= worker.employment ? '₹' + worker.employment.wage_rate : '—' %></div>
      </div>
      <div style="background:rgba(255,255,255,.12);border:0.5px solid rgba(255,255,255,.2);border-radius:8px;padding:8px 14px">
        <div style="font-size:.65rem;color:rgba(255,255,255,.65);text-transform:uppercase;letter-spacing:.05em">Aadhaar</div>
        <div style="font-size:.9rem;font-weight:600;color:#fff">••••&nbsp;<%= worker.aadhaar_last4 %></div>
      </div>
      <% if (worker.employment && worker.employment.uan_last4) { %>
      <div style="background:rgba(255,255,255,.12);border:0.5px solid rgba(255,255,255,.2);border-radius:8px;padding:8px 14px">
        <div style="font-size:.65rem;color:rgba(255,255,255,.65);text-transform:uppercase;letter-spacing:.05em">UAN</div>
        <div style="font-size:.9rem;font-weight:600;color:#fff">••••••••<%= worker.employment.uan_last4 %></div>
      </div>
      <% } %>
    </div>
  </div>
  <!-- Deactivate action -->
  <% if (['company_admin','super_admin'].includes(user.role)) { %>
  <div class="card-body py-2 px-3 d-flex justify-content-end" style="background:var(--em-line-2)">
    <form action="/workers/<%= worker.id %>?_method=DELETE" method="POST" class="d-inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="_method" value="DELETE">
      <button class="btn btn-outline-danger btn-sm" data-confirm="Deactivate <%= worker.name %>?">
        <i class="bi bi-person-x me-1"></i>Deactivate
      </button>
    </form>
  </div>
  <% } %>
</div>

<!-- Detail cards grid -->
<div class="row g-3">

  <!-- Personal Details -->
  <div class="col-md-6">
    <div class="card h-100" style="border-radius:12px">
      <div class="card-header" style="background:transparent;border-bottom:0.5px solid var(--em-line);padding:.85rem 1.1rem">
        <span style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--em-ink-3)">
          <i class="bi bi-person me-1" style="color:var(--em-accent)"></i>Personal Details
        </span>
      </div>
      <div class="card-body p-0">
        <div class="eos-doc-list px-3">
          <% [
            ['Father\'s Name', worker.father_name],
            ['Date of Birth', worker.dob],
            ['Gender', worker.gender],
            ['Marital Status', worker.marital_status],
            ['Mobile', worker.mobile],
            ['Email', worker.email || '—'],
            ['Aadhaar Address', worker.address_aadhaar],
          ].forEach(([lbl, val]) => { %>
          <div class="eos-doc-row" style="gap:0">
            <div style="flex:1;display:grid;grid-template-columns:140px 1fr;gap:6px;align-items:center">
              <span style="font-size:.72rem;color:var(--em-ink-3);text-transform:uppercase;letter-spacing:.04em"><%= lbl %></span>
              <span style="font-size:.84rem;color:var(--em-ink);font-weight:500"><%= val %></span>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- Employment Details -->
  <div class="col-md-6">
    <div class="card h-100" style="border-radius:12px">
      <div class="card-header" style="background:transparent;border-bottom:0.5px solid var(--em-line);padding:.85rem 1.1rem">
        <span style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--em-ink-3)">
          <i class="bi bi-briefcase me-1" style="color:var(--em-accent)"></i>Employment Details
        </span>
      </div>
      <div class="card-body p-0">
        <% if (worker.employment) { const e = worker.employment; %>
        <div class="eos-doc-list px-3">
          <% [
            ['Category', e.category],
            ['Zone', e.zone],
            ['Daily Wage', '₹' + e.wage_rate],
            ['Date of Joining', e.doj],
            ['PF / UAN', e.uan_last4 ? '••••••••' + e.uan_last4 : 'Not enrolled'],
            ['ESIC', e.esic_applicable ? 'Yes — ••••' + (e.esic_last4 || '') : 'Not applicable'],
            ['Bank Account', worker.bank_account_last4 ? '••••' + worker.bank_account_last4 : '—'],
            ['IFSC Code', worker.ifsc_code || '—'],
          ].forEach(([lbl, val]) => { %>
          <div class="eos-doc-row" style="gap:0">
            <div style="flex:1;display:grid;grid-template-columns:140px 1fr;gap:6px;align-items:center">
              <span style="font-size:.72rem;color:var(--em-ink-3);text-transform:uppercase;letter-spacing:.04em"><%= lbl %></span>
              <span style="font-size:.84rem;color:var(--em-ink);font-weight:500"><%= val %></span>
            </div>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <div class="text-center py-4" style="color:var(--em-ink-3);font-size:.84rem">
          <i class="bi bi-briefcase" style="display:block;font-size:1.5rem;opacity:.3;margin-bottom:.5rem"></i>
          No employment details recorded.
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Documents -->
  <div class="col-md-6">
    <div class="card" style="border-radius:12px">
      <div class="card-header d-flex justify-content-between align-items-center" style="background:transparent;border-bottom:0.5px solid var(--em-line);padding:.85rem 1.1rem">
        <span style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--em-ink-3)">
          <i class="bi bi-files me-1" style="color:var(--em-accent)"></i>Documents
        </span>
        <a href="/documents/pending" class="btn btn-outline-secondary btn-sm" style="font-size:.73rem">All pending</a>
      </div>
      <div class="card-body" style="padding:.75rem 1rem">
        <% if (!worker.documents || worker.documents.length === 0) { %>
        <div class="text-center py-3" style="color:var(--em-ink-3);font-size:.84rem">
          <i class="bi bi-file-earmark" style="display:block;font-size:1.5rem;opacity:.3;margin-bottom:.5rem"></i>
          No documents uploaded.
        </div>
        <% } else { %>
        <div class="eos-doc-list">
          <% (worker.documents || []).forEach(doc => {
            const icon = docIcons[doc.doc_type] || 'bi-file-earmark';
            const iconClass = doc.status === 'verified' ? 'green' : doc.status === 'rejected' ? 'red' : 'amber';
          %>
          <div class="eos-doc-row">
            <div class="eos-doc-icon <%= iconClass %>"><i class="bi <%= icon %>"></i></div>
            <div style="flex:1;min-width:0">
              <div class="eos-doc-name"><%= docLabels[doc.doc_type] || doc.doc_type %></div>
              <div class="eos-doc-meta">Uploaded <%= doc.created_at ? new Date(doc.created_at).toLocaleDateString('en-IN') : '' %></div>
            </div>
            <div class="eos-doc-status d-flex gap-1 align-items-center">
              <span class="badge <%= doc.status === 'verified' ? 'bg-success' : doc.status === 'rejected' ? 'bg-danger' : 'bg-warning' %>">
                <%= doc.status %>
              </span>
              <a href="/documents/<%= doc.id %>" target="_blank" class="btn btn-outline-secondary btn-sm" style="padding:.25rem .5rem">
                <i class="bi bi-eye"></i>
              </a>
              <% if (['company_admin','hr_payroll','super_admin'].includes(user.role) && doc.status === 'pending') { %>
              <form action="/documents/<%= doc.id %>/verify" method="POST" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-success btn-sm" title="Verify" style="padding:.25rem .5rem"><i class="bi bi-check"></i></button>
              </form>
              <form action="/documents/<%= doc.id %>/reject" method="POST" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="reason" value="Document unclear or incorrect">
                <button class="btn btn-danger btn-sm" title="Reject" style="padding:.25rem .5rem"
                  data-confirm="Reject this document?"><i class="bi bi-x"></i></button>
              </form>
              <% } %>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Compliance Checks -->
  <div class="col-md-6">
    <div class="card" style="border-radius:12px">
      <div class="card-header d-flex justify-content-between align-items-center" style="background:transparent;border-bottom:0.5px solid var(--em-line);padding:.85rem 1.1rem">
        <span style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--em-ink-3)">
          <i class="bi bi-shield-check me-1" style="color:var(--em-accent)"></i>Compliance Checks
        </span>
        <%
          const failCount = (worker.validation_results||[]).filter(v=>v.result==='fail').length;
          const passCount = (worker.validation_results||[]).filter(v=>v.result==='pass').length;
        %>
        <% if (failCount > 0) { %>
          <span class="badge bg-danger"><%= failCount %> issue<%= failCount > 1 ? 's' : '' %></span>
        <% } else if (passCount > 0) { %>
          <span class="badge bg-success"><i class="bi bi-check2"></i> All clear</span>
        <% } %>
      </div>
      <%
        /* Which checks are automated vs require human sign-off */
        const autoChecks   = new Set(['aadhaar_format','aadhaar_checksum','age_verification','uan_format',
                                       'esic_format','bank_format','duplicate_check','ifsc_master']);
        const humanChecks  = new Set(['wage_compliance','document_completeness']);
        const checkDesc = {
          aadhaar_format:         'Validates the Aadhaar number length and prefix.',
          aadhaar_checksum:       'Verifies Aadhaar with Verhoeff checksum algorithm.',
          age_verification:       'Confirms worker is ≥18 years old at date of joining.',
          uan_format:             'Validates UAN number format (if enrolled in PF).',
          esic_format:            'Validates ESIC number format (if applicable).',
          bank_format:            'Validates bank account number length and IFSC pattern.',
          duplicate_check:        'Ensures no duplicate Aadhaar / UAN within the company.',
          ifsc_master:            'Looks up IFSC in RBI master to confirm bank and branch.',
          wage_compliance:        'Compares daily wage against minimum wage for the skill category and zone. Requires HR sign-off when below minimum.',
          document_completeness:  'Checks that all mandatory KYC documents are uploaded and verified. Requires HR verification.',
        };
      %>
      <div class="card-body p-0">
        <% if (!worker.validation_results || worker.validation_results.length === 0) { %>
        <div class="text-center py-4" style="color:var(--em-ink-3);font-size:.84rem">
          <i class="bi bi-shield" style="display:block;font-size:1.5rem;opacity:.3;margin-bottom:.5rem"></i>
          No validation results yet. Run compliance check to populate.
        </div>
        <% } else { %>
        <div class="eos-doc-list px-3">
          <% (worker.validation_results || []).forEach(v => {
            const isAuto   = autoChecks.has(v.check_name);
            const isHuman  = humanChecks.has(v.check_name);
            const ic = v.result === 'pass' ? {cls:'green',icon:'bi-check-circle-fill'} :
                       v.result === 'fail' ? {cls:'red',  icon:'bi-x-circle-fill'} :
                                             {cls:'',     icon:'bi-dash-circle'};
          %>
          <div class="eos-doc-row" style="align-items:flex-start;gap:10px;padding:10px 0">
            <div class="eos-doc-icon <%= ic.cls %>" style="margin-top:2px"><i class="bi <%= ic.icon %>"></i></div>
            <div style="flex:1;min-width:0">
              <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
                <span class="eos-doc-name" style="text-transform:capitalize"><%= v.check_name.replace(/_/g,' ') %></span>
                <span style="font-size:.65rem;font-weight:600;padding:2px 7px;border-radius:10px;background:<%= isAuto ? 'var(--eos-blue-50)' : 'var(--eos-amber-50)' %>;color:<%= isAuto ? 'var(--eos-blue-600)' : 'var(--eos-amber-600)' %>">
                  <i class="bi <%= isAuto ? 'bi-robot' : 'bi-person-check' %>"></i>
                  <%= isAuto ? 'Auto' : 'Human review' %>
                </span>
              </div>
              <div class="eos-doc-meta mt-1"><%= v.details %></div>
              <% if (checkDesc[v.check_name]) { %>
              <div style="font-size:.7rem;color:var(--em-ink-3);margin-top:3px;font-style:italic"><%= checkDesc[v.check_name] %></div>
              <% } %>
              <% if (v.result === 'fail' && isHuman && ['company_admin','hr_payroll','super_admin'].includes(user.role)) { %>
              <div class="mt-2">
                <button type="button" class="btn btn-sm btn-outline-warning" style="font-size:.72rem"
                  onclick="alert('Acknowledgement feature coming soon. A company admin can override after manual review.')">
                  <i class="bi bi-person-check me-1"></i>Acknowledge / Override
                </button>
              </div>
              <% } %>
            </div>
            <div style="flex-shrink:0">
              <span class="badge <%= v.result === 'pass' ? 'bg-success' : v.result === 'fail' ? 'bg-danger' : 'bg-secondary' %>">
                <%= v.result.toUpperCase() %>
              </span>
            </div>
          </div>
          <% }) %>
        </div>
        <!-- Legend -->
        <div class="px-3 py-2" style="border-top:0.5px solid var(--em-line-2);display:flex;gap:12px;flex-wrap:wrap">
          <span style="font-size:.7rem;color:var(--em-ink-3)">
            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--eos-blue-600);margin-right:4px"></span>
            Auto — system validates instantly
          </span>
          <span style="font-size:.7rem;color:var(--em-ink-3)">
            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--eos-amber-600);margin-right:4px"></span>
            Human review — HR must confirm
          </span>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Family Members -->
  <% if (worker.family_members && worker.family_members.length > 0) { %>
  <div class="col-12">
    <div class="card" style="border-radius:12px">
      <div class="card-header" style="background:transparent;border-bottom:0.5px solid var(--em-line);padding:.85rem 1.1rem">
        <span style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--em-ink-3)">
          <i class="bi bi-people me-1" style="color:var(--em-accent)"></i>Family Members
        </span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-sm mb-0" style="font-size:.84rem">
            <thead style="background:var(--em-line-2)">
              <tr>
                <th style="padding:.65rem 1rem;font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;color:var(--em-ink-3);font-weight:700;border:none">Relation</th>
                <th style="padding:.65rem 1rem;font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;color:var(--em-ink-3);font-weight:700;border:none">Name</th>
                <th style="padding:.65rem 1rem;font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;color:var(--em-ink-3);font-weight:700;border:none">Aadhaar</th>
              </tr>
            </thead>
            <tbody>
              <% worker.family_members.forEach(m => { %>
              <tr>
                <td style="padding:.7rem 1rem;border-color:var(--em-line-2)" class="text-capitalize"><%= m.relation %></td>
                <td style="padding:.7rem 1rem;border-color:var(--em-line-2)"><%= m.name %></td>
                <td style="padding:.7rem 1rem;border-color:var(--em-line-2)"><%= m.aadhaar_last4 ? '••••••••' + m.aadhaar_last4 : '—' %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <% } %>

</div>
