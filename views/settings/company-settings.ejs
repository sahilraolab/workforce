<%- include('../partials/settings-tabs', { active: 'company', tabTitle: 'Company Settings', tabIcon: 'bi-building-gear', tabSubtitle: 'Registered address, regulatory regime and statutory form settings' }) %>

<div class="card border-0 shadow-sm" style="max-width:680px">
  <div class="card-body p-3 p-md-4">

    <form method="POST" action="/settings/company">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <h6 class="text-muted text-uppercase small mb-3">Establishment Details</h6>
      <div class="row g-3 mb-4">
        <div class="col-12">
          <label class="form-label fw-semibold">Registered Address</label>
          <textarea name="address" class="form-control" rows="2"
            placeholder="Full address — printed on statutory forms (salary slips, muster rolls, etc.)"
          ><%= company.address || '' %></textarea>
          <div class="form-text">This appears as the "Address of Establishment" on all generated statutory documents.</div>
        </div>
        <div class="col-12 col-md-6">
          <label class="form-label fw-semibold">Contact Email</label>
          <input type="email" name="contact_email" class="form-control" value="<%= company.contact_email || '' %>">
        </div>
        <div class="col-12 col-md-6">
          <label class="form-label fw-semibold">Contact Phone</label>
          <input type="tel" name="contact_phone" class="form-control" pattern="\d{10}" maxlength="10"
            placeholder="10-digit number" value="<%= company.contact_phone || '' %>">
        </div>
      </div>

      <hr>
      <h6 class="text-muted text-uppercase small mb-1">Regulatory / Statutory Settings</h6>
      <p class="text-muted mb-3" style="font-size:.8rem">
        These settings determine which statutory wage slip form is generated for your workers.
      </p>
      <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
          <label class="form-label fw-semibold">Regulatory Regime</label>
          <select name="regulatory_regime" class="form-select">
            <option value="code_on_wages_2019" <%= company.regulatory_regime !== 'osh_code_2020' ? 'selected' : '' %>>
              Code on Wages, 2019 — Form V
            </option>
            <option value="osh_code_2020" <%= company.regulatory_regime === 'osh_code_2020' ? 'selected' : '' %>>
              OSH Code, 2020 — Form XVI
            </option>
          </select>
          <div class="form-text">Most establishments under the Code on Wages 2019 use Form V.</div>
        </div>
        <div class="col-12 col-md-6">
          <label class="form-label fw-semibold">Jurisdiction</label>
          <select name="jurisdiction" class="form-select">
            <option value="central" <%= (company.jurisdiction || 'central') === 'central' ? 'selected' : '' %>>
              Central Rules (rule 52)
            </option>
            <option value="gujarat" <%= company.jurisdiction === 'gujarat' ? 'selected' : '' %>>
              Gujarat State Rules (rule 43)
            </option>
          </select>
          <div class="form-text">Select Gujarat state rules if your establishment falls under the Gujarat state notification.</div>
        </div>
      </div>

      <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Save Settings</button>
        <a href="/settings/profile" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
