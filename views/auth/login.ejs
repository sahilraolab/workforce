<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('sign_in') %> — <%= APP_NAME %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>

<div class="em-shell">
  <div class="em-card">

    <div class="em-logo">
      <div class="mark"><i class="bi bi-people-fill"></i></div>
      <span><%= APP_NAME %></span>
    </div>

    <h1 class="em-h1"><%= t('login_title') %></h1>
    <p class="em-sub"><%= t('login_subtitle') %></p>

    <div class="em-lang-row">
      <a href="/lang/en" class="em-lang-chip <%= currentLang === 'en' ? 'active' : '' %>">EN</a>
      <a href="/lang/hi" class="em-lang-chip <%= currentLang === 'hi' ? 'active' : '' %>">हिंदी</a>
      <a href="/lang/gu" class="em-lang-chip <%= currentLang === 'gu' ? 'active' : '' %>">ગુજરાતી</a>
      <a href="/lang/mr" class="em-lang-chip <%= currentLang === 'mr' ? 'active' : '' %>">मराठी</a>
      <a href="/lang/te" class="em-lang-chip <%= currentLang === 'te' ? 'active' : '' %>">తెలుగు</a>
    </div>

    <% if (error && error.length > 0) { %>
      <% error.forEach(msg => { %>
        <div class="alert alert-danger mb-3"><i class="bi bi-exclamation-circle-fill"></i><span><%= msg %></span></div>
      <% }) %>
    <% } %>
    <% if (success && success.length > 0) { %>
      <% success.forEach(msg => { %>
        <div class="alert alert-success mb-3"><i class="bi bi-check-circle-fill"></i><span><%= msg %></span></div>
      <% }) %>
    <% } %>
    <% if (info && info.length > 0) { %>
      <% info.forEach(msg => { %>
        <div class="alert alert-info mb-3"><i class="bi bi-info-circle-fill"></i><span><%= msg %></span></div>
      <% }) %>
    <% } %>

    <form action="/auth/login" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="em-field">
        <label class="em-label" for="email"><%= t('email_address') %></label>
        <div class="em-input-wrap">
          <input type="email" id="email" name="email" class="em-input"
            placeholder="you@company.com" required autofocus autocomplete="email">
          <button class="em-mic" type="button" title="Speak to fill"><i class="bi bi-mic-fill"></i></button>
        </div>
      </div>

      <div class="em-field" style="margin-bottom:1.6rem">
        <label class="em-label" for="password"><%= t('password') %></label>
        <div class="em-input-wrap">
          <input type="password" id="password" name="password" class="em-input"
            placeholder="<%= t('password_placeholder') %>" required autocomplete="current-password">
          <button type="button" class="em-mic" data-toggle-password data-target="password"
            data-show-label="<%= t('common_show_password') %>" data-hide-label="<%= t('common_hide_password') %>"
            aria-label="<%= t('common_show_password') %>">
            <i class="bi bi-eye"></i>
          </button>
        </div>
        <div class="form-text mt-1"><%= t('forgot_password_contact_admin') %></div>
      </div>

      <button type="submit" class="em-btn">
        <%= t('sign_in') %> <i class="bi bi-arrow-right"></i>
      </button>
    </form>

    <p class="em-foot">&copy; <%= new Date().getFullYear() %> <%= APP_NAME %> &middot; <%= t('all_rights_reserved') %></p>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
